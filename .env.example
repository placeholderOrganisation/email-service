# --- Core ---
PORT=4100
MONGODB_URI=mongodb://localhost:27017/email-service
# Comma-separated CORS origins, or * to allow all. These are server-to-server
# calls normally, so * is fine; tighten if you ever call from a browser.
CLIENT_ORIGIN=*

# Shared secret to unlock the /admin dashboard (GET /admin). Leave blank to
# disable the dashboard entirely. Generate with: openssl rand -hex 24
ADMIN_TOKEN=

# --- OpenAI (review analysis + reply drafting) ---
# Leave OPENAI_API_KEY blank to run on the deterministic mock (no tokens burned;
# dev/tests work offline). Set it locally (and on Render) to get live, varied
# reply drafts — without it every 5-star review gets a near-identical template.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway/proxy. Leave unset for default.
# OPENAI_BASE_URL=

# --- Google Business Profile (review sync + reply posting, optional) ---
# OAuth client of type "Web application" in Google Cloud. Leave any of these
# blank to disable Google features (manual import/mark-posted keep working).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4100/admin/google/callback
# Encrypts the stored refresh token (AES-256-GCM). 64 hex chars are used as the
# raw key; anything else is sha256-hashed. Generate with: openssl rand -hex 32
# Changing it invalidates the stored token (reconnect Google afterwards).
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Minutes between scheduled review syncs. 0 disables the scheduler ("Sync now" still works).
REVIEW_SYNC_INTERVAL_MINUTES=360

# --- Amazon SES (primary) ---
# SMTP credentials come from an IAM SMTP user in the SES console — NOT your AWS
# root keys. Host is region-specific.
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# 587 locally. On Render's free plan use 2587 (587/465/25 are blocked).
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=

# --- Brevo (failover, optional) ---
# Leave blank to run SES-only; the provider list is built from whatever is set.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
