# --- Core ---
PORT=4100
MONGODB_URI=mongodb://localhost:27017/email-service
# Comma-separated CORS origins, or * to allow all. These are server-to-server
# calls normally, so * is fine; tighten if you ever call from a browser.
CLIENT_ORIGIN=*

# Shared secret to unlock the /admin dashboard (GET /admin). Leave blank to
# disable the dashboard entirely. Generate with: openssl rand -hex 24
ADMIN_TOKEN=

# --- Amazon SES (primary) ---
# SMTP credentials come from an IAM SMTP user in the SES console — NOT your AWS
# root keys. Host is region-specific.
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=

# --- Brevo (failover, optional) ---
# Leave blank to run SES-only; the provider list is built from whatever is set.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
